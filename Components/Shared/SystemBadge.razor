@code {
    [Parameter, EditorRequired] public string Key { get; set; } = "";
    [Parameter] public bool Compact { get; set; }

    private string Label => Key.ToLowerInvariant() switch
    {
        "pulsar" => "Pulsar",
        "magnetar" => "Magnetar",
        "quasar" => "Quasar",
        _ => Key
    };

    private string Class => $"system-badge system-{Key.ToLowerInvariant()}";
}

<span class="@Class" title="@Label">@Label</span>

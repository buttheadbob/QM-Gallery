@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · QM Gallery</PageTitle>

<div class="container">
    <div class="empty-state" style="margin-top: 64px;" data-page-title="Something went wrong">
        <span class="empty-icon"><Icon Name="alert" Size="24"/></span>
        <h2>Something went wrong</h2>
        <p>The gallery hit an unexpected error. Reloading usually fixes it; the catalogue itself is unaffected.</p>
        @if (!string.IsNullOrWhiteSpace(RequestId))
        {
            <p class="subtle" style="margin-top: 10px; font-size: 11.5px;">Request: <span class="mono">@RequestId</span></p>
        }
        <div class="empty-actions">
            <a class="btn btn-primary" href="/">Reload the gallery</a>
            <a class="btn btn-ghost" href="/status">Catalogue status</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [PersistentState] public string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}

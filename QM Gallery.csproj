<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>QM_Gallery</RootNamespace>
        <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <UserSecretsId>qm-gallery-6f1a1f16-6b2b-4d9f-9a3e-2f5a2f4a7c41</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
      <PackageReference Include="Markdig" Version="1.6.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="tests/**/*.cs" />
      <None Remove="tests/**" />
      <Content Remove="tests/**" />
    </ItemGroup>

</Project>
